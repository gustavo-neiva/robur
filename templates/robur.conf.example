# .robur.conf — the machine contract for this repo.
# PARSED (key=value, allowlisted keys only). NEVER sourced, NEVER executed.
# Only the keys below are recognized; unknown keys are a `robur doctor` error.
# The agent is FORBIDDEN from editing this file (the loop rejects any turn that
# touches it). Edit it yourself; it is human-owned.
#
# NEVER put a `#` in a value: parsing truncates at the first `#`, so a Ruby
# interpolation like #{...} inside VERIFY_CMD is silently cut in half and
# RED-locks the loop.
#
# A repo that still has a `.ratchet.conf` keeps working untouched — robur reads
# the new name first and falls back to the old one. Rename when you feel like it.

ROBUR_PROTOCOL=1

# The work tracker. Auto-detected (PLAN.md > TODO.md > TASKS.md) if unset.
TRACKER_FILE=PLAN.md

# The green gate, run from the repo root before EVERY commit. A RED tree is
# never committed. EMPTY = commit with no gate (LOUD red warning each run; set
# this — no-gate is not safe-by-default).
VERIFY_CMD=npm test

# Data governance: which model providers may see this repo's code. Comma list of
# provider prefixes (e.g. zai,anthropic). Unset = the full global chain.
#ALLOWED_PROVIDERS=

# Model fallback chain for THIS repo (overrides the global default).
# Comma-separated, provider/id form, cheapest first.
#MODELS=zai/glm,anthropic/claude

# Per-step / all-done tokens the agent prints (keep in sync with AGENTS.md).
STEP_TOKEN=STEP_COMPLETE
DONE_TOKEN=ALL_DONE

# Paths to un-stage before each commit (runtime junk specific to this repo).
#COMMIT_EXCLUDE_GLOBS=

# Reasoning level each turn: off|minimal|low|medium|high|xhigh (empty = inherit).
#THINKING=medium

# Tiered model routing: override MODELS for plan/build/light/review turns.
# Unset tier → falls back to MODELS. Tier exhausted → MODELS before sleep.
#PLAN_MODELS=anthropic/claude-fable-5,anthropic/claude-opus-4-8
#BUILD_MODELS=anthropic/claude-sonnet-4-5,zai/glm-5.2
#LIGHT_MODELS=zai/glm-5-turbo,zai/glm-4.5-air
#REVIEW_MODELS=anthropic/claude-sonnet-4-5
# UNATTENDED plan turns (`robur plan --auto`, run by a scheduler). Unset ->
# falls back to PLAN. Set this to a cheap, abundant chain if anything plans on a
# beat: PLAN is usually your scarcest model, shared with your own sessions.
#AUTOPLAN_MODELS=kimi-coding/k3,zai/glm-5.3
#THINKING_AUTOPLAN=
#THINKING_PLAN=
#THINKING_BUILD=
# Speed-tuned models (ids matching flash|turbo|highspeed|air) are clamped to
# THINKING_LIGHT unless you set the tier's THINKING_* key explicitly — they
# spend a reasoning budget without earning it back.
#THINKING_LIGHT=off
#THINKING_REVIEW=

# Model ranking (STRONGEST FIRST) for derived tier chains — used when the
# tier-specific *_MODELS keys are unset. This is the ONE skill knob: no free
# signal ranks coding ability (price ≠ skill — a pricey creative model is not a
# better coder), so YOUR ordering is the truth. plan=top, light=bottom, build=middle.
# Unset → robur auto-derives by models.dev output-price as a cold-start prior
# and warns that it's a guess. Non-coder families (fable/mythos/vision/*-5v) are
# dropped from the AUTO path by construction; an explicit entry here is honored.
# STRONGLY RECOMMENDED to set this one line.
#MODEL_RANK=anthropic/claude-opus-4-8,anthropic/claude-sonnet-4-5,zai/glm-5.2,zai/glm-4.5-air

# PR flow (autonomous mode with human merge gates). Default: done.
#PR_CADENCE=done
# milestone → plan PR #0, review turn per milestone, PR per milestone, merge-gate.
#PR_CADENCE=milestone

# Review turn: max fail→fix cycles before human escalation. Default: 2.
#MAX_REVIEW_CYCLES=2

# Merge poll interval (secs). Default: 300 (5min).
#MERGE_POLL_SECS=300

# Max scout subagents for (hard) tasks when FANOUT is on. Default: 4.
#FANOUT_MAX=4

# Merge wait timeout (secs). Default: 259200 (72h). After timeout, loop stops with notification.
#MERGE_WAIT_TIMEOUT=259200

# PR size soft warning threshold (changed lines). Default: 400. Warning only, never blocks.
#PR_SOFT_MAX_LINES=400

# Parallel worktree mode: 0 = serial (default, ff's default branch on merge),
# 1 = parallel (stay on milestone branch, no checkout/pull). For N concurrent loops.
#PARALLEL=0

# Human-notify command (PR-gated flow). NOT recognized here — robur rejects it
# as an unknown key, because this file is one an autonomous agent could write
# and a notify command is a command the loop runs. Set it ONLY in the trusted,
# human-owned GLOBAL conf (~/.robur/conf):
#   NOTIFY_CMD='afplay /System/Library/Sounds/Glass.aiff'        # macOS sound
#   NOTIFY_CMD='osascript -e "display notification \"$1\" title robur"'  # macOS banner
#   NOTIFY_CMD='notify-send robur "$1"'                          # Linux
# The loop appends the message itself — do NOT add a trailing "$1" of your own
# or every notification is delivered twice.

# Derived rank snapshot: frozen on first use so tiers don't reshuffle mid-
# project on catalog churn. Inspect / force a refresh:
#   robur models rank           # show effective rank (explicit or derived)
#   robur models rank refresh   # re-derive from live pi + models.dev caches
#
# Tunables (uncomment to override defaults):
#TURN_TIMEOUT=1800
# Kill a turn whose (streaming) output stops growing this long — hung-request
# defense far cheaper than waiting out TURN_TIMEOUT. Buffered agents unaffected.
#STALL_TIMEOUT=300
#COOLDOWN=14400
# Per-provider cooldown override (COOLDOWN_<PROVIDER>). Beats global COOLDOWN for
# that provider's models. Provider = model's leading path segment, upper-cased.
#COOLDOWN_ZAI=3600
#HEARTBEAT=15
# Per-task attempt ceiling, for the life of ONE run, that reset_all cannot
# clear (unlike MAX_TRANSIENT strikes). Guards against the all-benched
# backoff ladder resetting strikes and restarting the identical cycle on the
# same task forever. Default: 20.
#MAX_TASK_ATTEMPTS=20

# Operational knobs are ENVIRONMENT variables, not keys here: the allowlist
# above is a contract `robur doctor` rejects unknown keys against, so anything
# you tune per-run (SUMMARY_LINES, POLL_INTERVAL, the runaway round-trip
# threshold) is read from ENV instead of from this file.
