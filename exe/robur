#!/usr/bin/env ruby
# frozen_string_literal: true

# Resolve symlink chain so exe/robur works from PATH, brew links, etc.
self_path = File.expand_path(__FILE__)
while File.symlink?(self_path)
  self_path = File.expand_path(File.readlink(self_path), File.dirname(self_path))
end
lib = File.expand_path("../lib", File.dirname(self_path))
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

require "robur"
require "robur/cli"

exit(Robur::CLI.run(ARGV) || 0)
